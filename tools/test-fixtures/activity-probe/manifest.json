{
  "manifest_version": 2,
  "name": "Stratus Activity Probe",
  "version": "1.0.0",
  "description": "Test fixture generating traffic for the extension activity panel",
  "browser_specific_settings": {
    "gecko": {
      "id": "activity-probe@stratus.test"
    }
  },
  "background": {
    "scripts": [
      "background.js"
    ]
  },
  "permissions": [
    "https://example.com/*"
  ]
}